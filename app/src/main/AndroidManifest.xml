<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The watcher must come back on its own after a reboot; the boot
         receiver is a documented exemption from background FGS starts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Special grant via Settings; UsageStatsManager-based detection per spec. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".EruditioApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eruditio"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Friction screen shown over the target app; never a hard block (spec). -->
        <activity
            android:name=".intercept.PauseActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Eruditio.Pause" />

        <!-- The quiet reading surface; both entry paths (home, pause) land here. -->
        <activity
            android:name=".ui.ReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.Eruditio" />

        <activity
            android:name=".ui.GleaningActivity"
            android:exported="false"
            android:theme="@style/Theme.Eruditio" />

        <service
            android:name=".intercept.UsageStatsWatcherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches app openings so the chosen friction pause can appear; runs while other apps are foreground." />
        </service>

        <!-- Always-on arming: reboot or update re-arms the watcher and its watchdog. -->
        <receiver
            android:name=".intercept.WatcherBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
